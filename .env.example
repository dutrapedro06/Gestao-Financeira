# Copie este arquivo para .env e ajuste os valores.
# O .env real nunca deve ser commitado (veja .gitignore).

# String de conexão com o Postgres.
# Os valores abaixo batem com o docker-compose.yml de desenvolvimento local.
DATABASE_URL=postgresql+psycopg2://gestao:gestao@localhost:5432/gestao_financeira

# Chave usada para assinar o cookie de sessão.
# Gere uma chave forte e aleatória, por exemplo com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# "development" ou "production"
ENVIRONMENT=development
